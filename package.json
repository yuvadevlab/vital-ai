{
  "name": "vital-ai",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/yuvadevlab/vital-ai.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "dev": "turbo dev --concurrency=25",
    "dev:web": "pnpm --filter @vital-ai/web dev",
    "dev:api": "pnpm --filter @vital-ai/api dev",
    "build": "turbo build",
    "start": "turbo start",
    "clean": "turbo clean",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:unit": "turbo test",
    "test:e2e": "pnpm --filter @vital-ai/web test:e2e",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @vital-ai/database db:generate",
    "db:migrate": "pnpm --filter @vital-ai/database db:migrate",
    "db:migrate:deploy": "pnpm --filter @vital-ai/database db:migrate:deploy",
    "db:migrate:status": "pnpm --filter @vital-ai/database db:migrate:status",
    "db:studio": "pnpm --filter @vital-ai/database db:studio",
    "codegen": "turbo codegen",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5",
    "turbo": "^2.5.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.63.0"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,scss,graphql,gql}": [
      "prettier --write"
    ]
  }
}
